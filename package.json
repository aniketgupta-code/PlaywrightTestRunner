{
  "name": "playwright-test-runner",
  "version": "1.0.0",
  "description": "Playwright-based E2E automation framework for Web applications",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "cross-env TAGS=@smoke playwright test",
    "test:headless": "cross-env HEADLESS=true playwright test",
    "report": "playwright show-report ./reports/html",
    "typecheck": "tsc --noEmit",
    "record-script": "playwright codegen -o ./media/script.js --target javascript --viewport-size \"1900, 950\"",
    "showtrace": "npx playwright show-trace ./media/trace.zip",
    "update:browserstack": "npm update browserstack-node-sdk --save-dev",
    "test:browserstack": "browserstack-node-sdk playwright test",
    "test:browserstack:smoke": "cross-env TAGS=@smoke browserstack-node-sdk playwright test",
    "local:test:browserstack": "node run-browserstack.js"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^20.0.0",
    "@types/superagent": "^8.1.0",
    "browserstack-node-sdk": "^1.55.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "is-ci": "^3.0.1",
    "moment": "^2.29.4",
    "otplib": "^13.4.0",
    "superagent": "^8.1.2",
    "typescript": "^5.4.0"
  }
}
